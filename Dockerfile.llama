FROM ubuntu:22.04

# Copy pre-extracted llama.cpp b7633 binary folder from repo
COPY llama-b7633/ /opt/llama/

# llama-server links against shared libs in the same folder.
# Add that folder to the dynamic linker search path.
RUN echo "/opt/llama" > /etc/ld.so.conf.d/llama.conf && ldconfig \
    && ln -s /opt/llama/llama-server /usr/local/bin/llama-server \
    && chmod +x /opt/llama/llama-server

EXPOSE 8080

# -ngl 0 = CPU only (safe default for judges without NVIDIA Container Toolkit).
# See README to enable GPU.
CMD ["llama-server", \
     "-m", "/models/LFM2.5-VL-450M-Q4_0.gguf", \
     "--mmproj", "/models/mmproj-LFM2.5-VL-450m-F16.gguf", \
     "-c", "8192", \
     "--port", "8080", \
     "-ngl", "0"]
